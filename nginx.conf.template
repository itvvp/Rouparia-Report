server {
    listen 80;
    root /usr/share/nginx/html;
    server_tokens off;

    # CSP: o connect-src deixa o browser falar com a API (${API_ORIGIN}). Sem isto o login é bloqueado quando a API tem outro domínio.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${API_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'";

    # assets com hash no nome: cache longa. O index.html nunca fica em cache, senão um deploy novo não chega aos utilizadores.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security.conf;
        add_header Content-Security-Policy $csp always;
    }

    # A API só existe na rede interna do Docker (sem porta publicada nem domínio): o browser fala só com esta origem,
    # por isso os cookies são do mesmo site e não há CORS.
    # - /api/x -> API /x
    # - o nome vai numa variável (com o resolver do Docker) para o nginx arrancar mesmo com a API em baixo
    # - o cookie de refresh da API tem path=/auth; para o browser o enviar a /api/auth/* o path é reescrito aqui
    location /api/ {
        resolver 127.0.0.11 valid=10s;
        set $api ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_cookie_path /auth /api/auth;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # qualquer rota desconhecida devolve o index.html
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security.conf;
        add_header Content-Security-Policy $csp always;
        try_files $uri /index.html;
    }
}
